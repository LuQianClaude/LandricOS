<?xml version="1.0" encoding="utf-8"?>
<!-- Lira - Sirius Villa AndroidManifest
     所有权限可拒绝，拒绝后对应功能禁用不崩溃
     署名: Lira -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 录音（语音消息 + 唤醒词） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 定位（哨兵 GPS + get_gps_location skill） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 屏幕截图（哨兵） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 开机自启（哨兵/唤醒保持） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 唤醒锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LiraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiriusVilla"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 人设 -->
        <activity
            android:name=".PersonaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 图片预览 -->
        <activity
            android:name=".ImagePreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 日记编辑 -->
        <activity
            android:name=".DiaryEditActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- TTS 语音朗读 Service -->
        <service
            android:name=".service.TtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 语音唤醒 Service -->
        <service
            android:name=".service.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 哨兵 Service -->
        <service
            android:name=".service.SentinelService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
