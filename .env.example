# LandricsVilla environment configuration.
#
# Copy this file to .env and adjust as needed. All values below are safe
# defaults; none of them are secrets that need to be kept private except
# JWT_SECRET, which you MUST change before running in production.
#
# IMPORTANT: AI provider API keys are NOT set here. Users add their own
# provider key + base URL via the app Settings page after login. The server
# stores those per-user credentials and uses them only to call the user's
# chosen provider. Do not put provider keys in this file.

# Host and port the FastAPI server binds to.
APP_HOST=0.0.0.0
APP_PORT=8000

# SQLite database URL. landricsvilla.db is created automatically on first run
# under database/. Use a full path here only if you want a non-default location.
DB_URL=sqlite:///./database/landricsvilla.db

# Secret used to sign JWT auth tokens. CHANGE THIS before any real deployment.
# Generate one, for example, with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Directory where user-generated files are stored (photos, audio, memories, etc.).
STORAGE_DIR=./storage

# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the web frontend.
# Include the Android WebView's effective origin if you serve the frontend
# from a different host than the backend.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
